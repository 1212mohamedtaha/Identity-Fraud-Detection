# Copy to .env (or export these in your shell). All are optional.

# Which LLM to use: claude | openai | none.
# Default: claude when ANTHROPIC_API_KEY is set, otherwise none (offline mode).
VERITY_LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# Model name. Claude default: claude-opus-5-5.
VERITY_LLM_MODEL=

# For VERITY_LLM_PROVIDER=openai (any OpenAI-compatible API: OpenAI, Ollama, LM Studio, vLLM, Groq...)
# VERITY_LLM_BASE_URL=http://localhost:11434/v1
# VERITY_LLM_API_KEY=
